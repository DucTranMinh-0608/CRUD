CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
  INSERT INTO public.users (
    "SupabaseID",
    "Email",
    "Ten",
    "SoDienThoai",
    "ChucVu",
    "TrangThai"
  )
  VALUES (
    NEW.id,
    NEW.email,
    COALESCE(NEW.raw_user_meta_data->>'Ten', ''),
    COALESCE(NEW.raw_user_meta_data->>'SoDienThoai', ''),
    NEW.raw_user_meta_data->>'ChucVu',
    'enabled'
  );

  RETURN NEW;
END;
$$;